/* Litebee IDE "flight console" theme (docs/UI_DESIGN.md).
   Every colour of the application lives in this file. Tokens are declared
   below as "@name value" lines inside this comment and substituted into the
   rules by app/theme.py; custom-painted widgets read the same tokens.

@bg        #12161C
@panel     #161B22
@card      #1A2029
@border    #2A3441
@text      #E6EAF0
@text2     #8B97A8
@accent    #6AA9FF
@on_accent #0B1220
@danger    #E5484D
@danger_dn #C93A3F
@warn      #F5A524
@ok        #3FB950
@grid      #243040
@sel       #263447
@qr        #3A4C66
@drone_body  #E9EDF2
@drone_grey  #9AA4B2
@drone_dark  #4A5565
@drone_guard #7E8999
*/

* {
    font-family: "Segoe UI";
    font-size: 13px;
    color: @text;
}

QMainWindow, QDialog, QMessageBox { background: @bg; }
QWidget#root, QStackedWidget { background: @bg; }

QToolTip {
    background: @card; color: @text; border: 1px solid @border; padding: 4px 6px;
}

/* panels and cards */
QFrame#panel, QWidget#panel { background: @panel; border: 1px solid @border; border-radius: 8px; }
QFrame#card { background: @card; border: 1px solid @border; border-radius: 8px; }
QFrame#card[selected="true"] { border: 1px solid @accent; }
QWidget#header, QWidget#toolbar, QWidget#bottom { background: @bg; }

QLabel { background: transparent; }
QLabel#secondary, QLabel[role="secondary"] { color: @text2; font-size: 12px; }
QLabel#projectName { font-weight: 500; font-size: 14px; }
QLabel#mono, QLabel[role="mono"] { font-family: "Cascadia Mono", "Consolas"; }
QLabel#emptyTitle { font-size: 18px; font-weight: 500; }

/* buttons */
QPushButton, QToolButton {
    background: @card; border: 1px solid @border; border-radius: 6px;
    padding: 6px 14px; color: @text;
}
QPushButton:hover, QToolButton:hover { border-color: @text2; }
QPushButton:pressed, QToolButton:pressed { background: @sel; }
QPushButton:focus, QToolButton:focus, QCheckBox:focus, QComboBox:focus, QLineEdit:focus,
QSpinBox:focus, QPlainTextEdit:focus, QListWidget:focus, QSlider:focus {
    border: 2px solid @accent;
}
QPushButton:disabled, QToolButton:disabled { color: @text2; background: @panel; border-color: @border; }
QToolButton:checked { background: @sel; border-color: @accent; }
QToolButton[compact="true"] { padding: 2px 8px; font-size: 12px; }

QPushButton#primary { background: @accent; color: @on_accent; border: 1px solid @accent; font-weight: 500; }
QPushButton#primary:hover { border-color: @text; }
QPushButton#primary:disabled { background: @panel; color: @text2; border-color: @border; }

QPushButton#emergency {
    background: @danger; color: @on_accent; border: 1px solid @danger; border-radius: 8px;
    font-size: 15px; font-weight: 500; padding: 12px 22px; min-height: 28px;
}
QPushButton#emergency:hover { border-color: @text; }
QPushButton#emergency:pressed { background: @danger_dn; }
QPushButton#emergency:focus { border: 2px solid @text; }

/* inputs */
QLineEdit, QSpinBox, QComboBox {
    background: @panel; border: 1px solid @border; border-radius: 6px; padding: 4px 8px;
    selection-background-color: @sel;
}
QComboBox QAbstractItemView { background: @card; border: 1px solid @border; selection-background-color: @sel; }
QCheckBox { spacing: 8px; background: transparent; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid @text2; border-radius: 4px; background: @panel; }
QCheckBox::indicator:checked { background: @accent; border-color: @accent; }
QCheckBox#arm::indicator:checked { background: @warn; border-color: @warn; }
QCheckBox:disabled { color: @text2; }

/* editor and lists */
QPlainTextEdit {
    background: @panel; border: 1px solid @border; border-radius: 8px;
    font-family: "Cascadia Mono", "Consolas"; font-size: 13px; selection-background-color: @sel;
}
QPlainTextEdit#log { font-size: 12px; color: @text2; }
QListWidget {
    background: @panel; border: 1px solid @border; border-radius: 8px; outline: 0;
}
QListWidget::item { padding: 4px 8px; }
QListWidget::item:selected { background: @sel; color: @text; }
QListView { background: @card; border: 1px solid @border; selection-background-color: @sel; }

/* tabs */
QTabWidget::pane { border: 1px solid @border; border-radius: 8px; background: @panel; top: -1px; }
QTabBar::tab { background: transparent; color: @text2; padding: 6px 14px; border: none; }
QTabBar::tab:selected { color: @text; border-bottom: 2px solid @accent; }
QTabBar::tab:hover { color: @text; }

/* splitter, scroll, slider */
QSplitter::handle { background: @bg; }
QSplitter::handle:horizontal { width: 6px; }
QSplitter::handle:vertical { height: 6px; }
QSplitter::handle:hover { background: @border; }
QScrollArea { border: none; background: transparent; }
QScrollArea > QWidget > QWidget#cards { background: transparent; }
QScrollBar:horizontal { background: @bg; height: 10px; }
QScrollBar:vertical { background: @bg; width: 10px; }
QScrollBar::handle { background: @border; border-radius: 4px; min-width: 24px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QSlider::groove:horizontal { height: 4px; background: @border; border-radius: 2px; }
QSlider::sub-page:horizontal { background: @accent; border-radius: 2px; }
QSlider::handle:horizontal { background: @text; width: 14px; margin: -6px 0; border-radius: 7px; }

QMenu { background: @card; border: 1px solid @border; }
QMenu::item:selected { background: @sel; }

/* reference panel (app/reference_panel.py) */
QMainWindow::separator { background: @bg; width: 6px; height: 6px; }
QMainWindow::separator:hover { background: @border; }
QTreeWidget#referenceTree {
    background: @panel; border: 1px solid @border; border-radius: 8px; outline: 0;
}
QTreeWidget#referenceTree::item { padding: 3px 6px; }
QTreeWidget#referenceTree::item:selected { background: @sel; }
QTreeWidget#referenceTree:focus, QTextBrowser#referenceBody:focus { border: 2px solid @accent; }
QTextBrowser#referenceBody, QPlainTextEdit#referenceExample {
    background: @panel; border: 1px solid @border; border-radius: 8px; selection-background-color: @sel;
}
QPlainTextEdit#referenceExample { background: @card; font-size: 12px; }
QLabel#statusBadge { border: 1px solid @text2; border-radius: 6px; padding: 2px 8px; color: @text2; }
QLabel#statusBadge[status="verified"] { border-color: @ok; color: @ok; }
QLabel#statusBadge[status="sim"] { border-color: @warn; color: @warn; }
QLabel#statusBadge[status="helper"], QLabel#statusBadge[status="absent"] { border-color: @text2; color: @text2; }
QToolButton#reference:checked, QPushButton#reference:checked { background: @sel; border-color: @accent; }
QToolButton#refClose { padding: 2px 10px; }
